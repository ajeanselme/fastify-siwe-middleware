{
  "name": "fastify-siwe-middleware",
  "version": "1.0.0",
  "description": "A Fastify middleware for Sign-In With Ethereum (SIWE) authentication",
  "keywords": [
    "fastify",
    "siwe",
    "middleware",
    "auth"
  ],
  "homepage": "https://github.com/ajeanselme/fastify-siwe-middleware#readme",
  "bugs": {
    "url": "https://github.com/ajeanselme/fastify-siwe-middleware/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajeanselme/fastify-siwe-middleware.git"
  },
  "license": "ISC",
  "author": "antoinedotsh",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "directories": {
    "test": "tests"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "start": "tsx src/app.ts",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "@signinwithethereum/siwe": "^4.2.0",
    "@types/node": "^26.0.1",
    "fastify": "^5.9.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "siwe": "^3.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.20.0",
    "ethers": "^6.17.0",
    "node-pg-migrate": "^8.0.4",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "module": "./dist/index.js",
  "sideEffects": [
    "./src/types/fastify.ts"
  ]
}
